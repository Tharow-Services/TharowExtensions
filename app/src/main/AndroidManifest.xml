<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="tachiyomi.extension"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TharowExtensions">
        <meta-data
            android:name="tachiyomix.name"
            android:value="Tharow Extensions" />

        <meta-data
            android:name="tachiyomi.extension.class"
            android:value="net.tharow.extensions.TharowSourceFactory" />

        <meta-data
            android:name="tachiyomi.extension.nsfw"
            android:value="0" />

        <meta-data
            android:name="tachiyomix.contentWarning"
            android:value="0" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TharowExtensions">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>